<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CSR Dream Journal</title>
<style>
  @font-face {
    font-family: 'Playfair Display';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url(data:font/woff2;charset=utf-8;base64,) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2122, U+2191, U+2193, U+2212, U+2215;
  }
  @font-face {
    font-family: 'Caveat';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url(data:font/woff2;charset=utf-8;base64,) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2122, U+2191, U+2193, U+2212, U+2215;
  }
  :root {
    /* Journal v2 Phase 4 (glassmorphic brand pass) — one light register,
       matched to docs-site's Editorial Glassmorphic Bento
       (docs-site/DESIGN_SYSTEM.md). Journal v2 Phase 6 adds a dark variant
       of this SAME glass brand below (deep indigo night, not the banned
       flat-black/SaaS-grey anti-pattern) — token swap only, see the two
       dark blocks right after this one. */
    --sky-top: #e8e4f0;
    --sky-bottom: #c8cae0;
    --ink: #1a1a2e;
    --slate: #4a4a6a;
    --label: #8a8aaa;
    --purple: #6b5b95;
    --rose: #b5838d;
    --sage: #7c9473;
    --amber-cream: #d4a574;
    --glass: rgba(255, 255, 255, 0.55);
    --glass-border: rgba(255, 255, 255, 0.3);
    /* Brand-polish overlay for hover/selected states (index-row.selected
       background, stage-card/artifact-tile hover border) — same value as
       --glass today, kept as its own token so the dark variant can dim it
       instead of literally whiting out a dark panel. */
    --highlight: rgba(255, 255, 255, 0.55);
    --glass-blur: blur(16px);
    --radius-pane: 1.25rem;
    --radius-tile: 0.75rem;
    --postit-lavender: linear-gradient(135deg, #e3ddf0 0%, #d3cbe8 100%);
    --postit-rose: linear-gradient(135deg, #f3dde1 0%, #e8c8d0 100%);
    --serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
    --cursive: 'Caveat', 'Bradley Hand', 'Segoe Print', cursive;

    /* Legacy variable names kept so every existing selector below (and in
       report.rs's MAILBOX_CSS) repaints under the new palette with zero
       selector-level edits — only the values moved. */
    --bg: rgba(255, 255, 255, 0.35);
    --bg-card: var(--glass);
    --fg: var(--ink);
    --fg-muted: var(--slate);
    --border: var(--glass-border);
    --accent: var(--purple);
    /* Text-role red/amber/green are accessible-darkened variants of the
       spec's rose/amber-cream/sage hues, not the literal pastel hexes:
       measured against the glass-over-sky worst case (see journal-smoke.mjs
       contrast note), the literal pastels read ~2.6-2.8:1 as small badge/
       glyph text — well under the 4.5:1 body-text floor. --rose/--sage/
       --amber-cream above stay true to the spec for decorative tint use
       (post-its, borders, fills), where that floor does not apply. */
    --red: #64484e;
    --red-bg: rgba(181, 131, 141, 0.2);
    --amber: #755b40;
    --amber-bg: rgba(212, 165, 116, 0.22);
    --green: #3f5238;
    --green-bg: rgba(124, 148, 115, 0.2);
  }

  /* Journal v2 Phase 6: dark variant of the SAME glassmorphic brand — deep
     indigo night (never flat black, never SaaS grey), token swap only. Two
     forms, both defining the identical token set so either input source
     (OS-level prefers-color-scheme, or the in-page toggle's data-theme
     attribute) repaints the whole document with zero per-component rules:
       1. @media (prefers-color-scheme: dark), guarded by :not([data-theme=
          "light"]) so the explicit toggle can still force light mode on a
          dark-OS visitor;
       2. [data-theme="dark"] on the root, which wins regardless of OS
          preference once the toggle is clicked.
     Every color below is a text-role token verified >= 4.5:1 against the
     darkest realistic backdrop (glass-over-sky composite); see the
     contrast table in the implementing commit message, not restated here
     so the two blocks below never drift out of sync with each other. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --sky-top: #1a1a2e;
      --sky-bottom: #26263e;
      --ink: #e8e6f0;
      --slate: #9a98b5;
      --label: #9694ae;
      --purple: #9d8cc4;
      --rose: #d9a3ac;
      --sage: #a8c29c;
      --amber-cream: #e0b988;
      --glass: rgba(30, 30, 46, 0.55);
      --glass-border: rgba(255, 255, 255, 0.12);
      --highlight: rgba(255, 255, 255, 0.14);
      --postit-lavender: linear-gradient(135deg, #322f52 0%, #3d3860 100%);
      --postit-rose: linear-gradient(135deg, #4a2f3d 0%, #5c3548 100%);
      --bg: rgba(30, 30, 46, 0.35);
      --red: #f0a9b2;
      --red-bg: rgba(229, 128, 140, 0.22);
      --amber: #f0c58c;
      --amber-bg: rgba(224, 163, 85, 0.24);
      --green: #a9dd98;
      --green-bg: rgba(143, 194, 122, 0.22);
    }
  }
  :root[data-theme="dark"] {
    --sky-top: #1a1a2e;
    --sky-bottom: #26263e;
    --ink: #e8e6f0;
    --slate: #9a98b5;
    --label: #9694ae;
    --purple: #9d8cc4;
    --rose: #d9a3ac;
    --sage: #a8c29c;
    --amber-cream: #e0b988;
    --glass: rgba(30, 30, 46, 0.55);
    --glass-border: rgba(255, 255, 255, 0.12);
    --highlight: rgba(255, 255, 255, 0.14);
    --postit-lavender: linear-gradient(135deg, #322f52 0%, #3d3860 100%);
    --postit-rose: linear-gradient(135deg, #4a2f3d 0%, #5c3548 100%);
    --bg: rgba(30, 30, 46, 0.35);
    --red: #f0a9b2;
    --red-bg: rgba(229, 128, 140, 0.22);
    --amber: #f0c58c;
    --amber-bg: rgba(224, 163, 85, 0.24);
    --green: #a9dd98;
    --green-bg: rgba(143, 194, 122, 0.22);
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-bottom) 100%);
    background-attachment: fixed;
    color: var(--fg);
    font-family: system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .wrap {
    max-width: 880px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }
  header.hero {
    margin-bottom: 2rem;
  }
  .hero-title-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  header.hero h1 {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.9rem;
    margin: 0 0 0.35rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  /* Journal v2 Phase 6: theme toggle — cycles auto -> dark -> light ->
     auto, nothing persisted (default is always "auto" on reload). Token-
     driven only, so it repaints for free under both dark blocks above;
     font-family is reset off the h1's serif since a <button> would
     otherwise inherit it from this row. */
  .theme-toggle {
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.95rem;
    line-height: 1;
    color: var(--ink);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    cursor: pointer;
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
  }
  .theme-toggle:hover {
    border-color: var(--purple);
  }
  header.hero .subtitle {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin: 0;
  }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.82rem;
    color: var(--fg-muted);
  }
  .meta-row code {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05rem 0.4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .totals {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0 2rem;
  }
  .totals .stat {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.9rem 0.75rem;
    text-align: center;
  }
  .totals .stat .n {
    font-size: 1.5rem;
    font-weight: 600;
    display: block;
  }
  .totals .stat .label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }
  .totals .stat.obsolete .n { color: var(--red); }
  .totals .stat.superseded .n { color: var(--amber); }
  .totals .stat.reinstated .n { color: var(--green); }

  section {
    margin-bottom: 2.5rem;
  }
  section > h2 {
    font-size: 1.05rem;
    margin: 0 0 0.9rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .day-group {
    margin-bottom: 1.5rem;
  }
  .day-heading {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 0.5rem;
  }
  .event, .forgotten-row {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
    margin-bottom: 0.55rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.65rem;
  }
  .badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .badge.obsolete { color: var(--red); background: var(--red-bg); }
  .badge.superseded { color: var(--amber); background: var(--amber-bg); }
  .badge.reinstated { color: var(--green); background: var(--green-bg); }
  .symbol {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .file {
    color: var(--fg-muted);
    font-size: 0.82rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    word-break: break-all;
  }
  .oids {
    margin-left: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.76rem;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .successor-line {
    flex: 1 0 100%;
    font-size: 0.8rem;
    color: var(--fg-muted);
  }
  .successor-line code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .empty-state {
    background: var(--bg-card);
    border: 1px dashed var(--border);
    border-radius: 12px;
    padding: 2.2rem 1.5rem;
    text-align: center;
    color: var(--fg-muted);
  }
  .empty-state .glyph {
    font-size: 1.8rem;
    display: block;
    margin-bottom: 0.5rem;
  }
  footer {
    text-align: center;
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin-top: 3rem;
  }
</style>
</head>
<body>
<div class="wrap">

  <header class="hero">
    <div class="hero-title-row">
      <h1>☾ CSR Dream Journal</h1>
      <button type="button" class="theme-toggle" data-theme-state="auto" aria-label="Theme: auto (click to change)">&#9680;</button>
    </div>
    <p class="subtitle">Deterministic supersession verdicts drawn from content-hash stamps and git ancestry — zero LLM, zero guessing.</p>
    <div class="meta-row">
      {% if data.has_run %}
        <span>Last dream: <code>{{ data.last_run_at }}</code> at HEAD <code>{{ data.last_run_head_short }}</code></span>
      {% else %}
        <span>No dream cycle has run yet.</span>
      {% endif %}
      <span>Generated {{ data.generated_at }}</span>
    </div>
  </header>

  {% if data.is_empty %}
  <div class="empty-state">
    <span class="glyph">☾</span>
    No dreams yet. Run <code>csr-engine dream</code> to audit the witness ledger against current HEAD.
  </div>
  {% else %}

  <section>
    <h2>Timeline</h2>
    {% for day in data.days %}
    <div class="day-group">
      <p class="day-heading">{{ day.date }}</p>
      {% for event in day.events %}
      <div class="event">
        <span class="badge {{ event.verdict_slug }}">{{ event.verdict_label }}</span>
        <span class="symbol">{{ event.symbol }}</span>
        <span class="file">{{ event.file_relative }}</span>
        <span class="oids">receipt {{ event.receipt_short | default("—") }} · HEAD {{ event.observed_head_short }} · {{ event.time }}</span>
        {% if event.successor_line %}
        <span class="successor-line">{{ event.successor_line }}</span>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </section>

  <section>
    <h2>What CSR forgot</h2>
    {% if data.forgotten %}
      {% for item in data.forgotten %}
      <div class="forgotten-row">
        <span class="badge obsolete">Demoted</span>
        <span class="symbol">{{ item.symbol }}</span>
        <span class="file">{{ item.file_relative }}</span>
        <span class="oids">{{ item.verdict_label }} · receipt {{ item.receipt_short | default("—") }} · HEAD {{ item.observed_head_short }}</span>
      </div>
      {% endfor %}
    {% else %}
      <div class="empty-state">Nothing is currently demoted — every audited symbol is either intact or annotated, never fully stale.</div>
    {% endif %}
  </section>

  {% endif %}

  <footer>csr-engine dream --report · self-contained, zero network requests</footer>
</div>
</body>
</html>
