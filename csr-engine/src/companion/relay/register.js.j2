    case 'ui.toast': return $.ui.toast(c.a[0])
    case 'ui.invalidate': return $.ui.invalidate('ui.render')
    case 'ui.open': return $.ui.open(c.a[0])
    case 'ui.status': return $.ui.status(c.a[0])
    case 'ui.log': return $.ui.log(c.a[0], c.a[1])
    case 'model.fork': return $.model.fork(c.a[0])
    case 'agent.list': return $.agent.list()
    case 'prompt.read': return $.prompt.read()
    case 'prompt.fill': return $.prompt.fill(c.a[0])
    case 'config.list': return $.config.list()
    case 'config.set': return $.config.set(c.a[0])
    case 'session.compact': return $.session.compact(c.a[0])
    case 'session.usage': return $.session.usage()
    case 'session.model': return $.session.model()
    case 'session.surfaces': return $.session.surfaces()
    case 'session.append': return $.session.append(c.a[0])
    case 'command.register': return $.command.register(c.a[0])
    default: throw new Error('csr: unknown call ' + c.m)
