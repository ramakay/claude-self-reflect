// Generated by csr-engine; do not edit. It holds no logic: every hook is forwarded to
// `csr-engine companion serve` over a Unix socket.
const ENGINE = '{{ engine }}'
const SOCK_DIR = '{{ sock_dir }}'
const V = '{{ version }}'
let sock = null
let gen = 0
async function post($, path, body) {
  const r = await $.http.fetch('http://csr' + path, { method: 'POST', body: JSON.stringify({ v: V, ...body }), socketPath: sock })
  if (!r.ok) throw new Error('csr ' + path + ' ' + r.status)
  return JSON.parse(r.text)
}
async function act($, c) {
