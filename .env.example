# ============================================================================
# Qdrant Vector Database Configuration
# ============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_MEMORY=4g

# Qdrant API Key (optional for standalone, REQUIRED for shared/team use)
# STANDALONE: Leave empty if running locally just for yourself
# SHARED: Set a strong API key if multiple people access this Qdrant instance
QDRANT_API_KEY=

# ============================================================================
# Embedding Configuration
# ============================================================================
# Set to true to use local FastEmbed embeddings (recommended for privacy)
# Set to false to use Voyage AI cloud embeddings
PREFER_LOCAL_EMBEDDINGS=true

# Voyage AI Configuration (optional - only needed if PREFER_LOCAL_EMBEDDINGS=false)
# Get your API key from https://www.voyageai.com/
VOYAGE_KEY=

# ============================================================================
# Memory Decay Configuration
# ============================================================================
ENABLE_MEMORY_DECAY=true
DECAY_WEIGHT=0.3
DECAY_SCALE_DAYS=90

# ============================================================================
# Directory Configuration
# ============================================================================
# Main CSR home directory (default: ~/.claude-self-reflect)
CSR_HOME=~/.claude-self-reflect

# Configuration directory (default: $CSR_HOME/config)
CSR_CONFIG_DIR=~/.claude-self-reflect/config

# Batch state directory (default: $CSR_HOME/batch_state)
CSR_BATCH_STATE_DIR=~/.claude-self-reflect/batch_state

# Batch queue directory (default: $CSR_HOME/batch_queue)
CSR_BATCH_QUEUE_DIR=~/.claude-self-reflect/batch_queue

# Claude projects directory (default: ~/.claude/projects)
CLAUDE_PROJECTS_DIR=~/.claude/projects

# Legacy paths (for backward compatibility)
CLAUDE_LOGS_PATH=~/.claude/projects
CONFIG_PATH=~/.claude-self-reflect/config

# ============================================================================
# Batch Processing Configuration
# ============================================================================
# Trigger batch after this many files (default: 10)
BATCH_SIZE_TRIGGER=10

# Or trigger after this many minutes (default: 30)
BATCH_TIME_TRIGGER_MINUTES=30

# Subprocess timeout in seconds (default: 1800 = 30 minutes)
# Increase for very large batch operations
SUBPROCESS_TIMEOUT_SECONDS=1800

# ============================================================================
# Watcher Timing & Priority
# ============================================================================
# Files modified in last N minutes are HOT (process immediately) (default: 5)
HOT_WINDOW_MINUTES=5

# Files modified in last N hours are WARM (default: 24)
WARM_WINDOW_HOURS=24

# Max COLD files to process per cycle (default: 5)
MAX_COLD_FILES=5

# HOT file check interval in seconds (default: 2)
HOT_CHECK_INTERVAL_S=2

# Normal check interval in seconds (default: 60)
NORMAL_CHECK_INTERVAL_S=60

# ============================================================================
# Performance Tuning (Legacy)
# ============================================================================
WATCH_INTERVAL=5
MAX_MEMORY_MB=600
CHUNK_SIZE=50
MAX_FILES_PER_CYCLE=10
MAX_COLD_FILES_PER_CYCLE=3

# ============================================================================
# API Keys
# ============================================================================
# Anthropic API key (required for batch API)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================================================
# Security Notes
# ============================================================================
# STANDALONE vs SHARED modes:
# - STANDALONE: Single-user on your own machine - no QDRANT_API_KEY needed
# - SHARED: Multi-user or team access - MUST set QDRANT_API_KEY for security
#
# When to use each mode:
# - STANDALONE: Your personal claude-self-reflect installation
# - SHARED: When multiple people access the same Qdrant database
#
# NEVER commit actual API keys to version control!
# Add .env to your .gitignore file
